{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kairen Interacting Character Record",
  "type": "object",
  "required": ["character_id", "name", "tracking_status", "qualifying_interactions"],
  "properties": {
    "character_id": {"type": "string"},
    "name": {"type": "string"},
    "tracking_status": {"enum": ["PROPOSED", "CANON", "REJECTED"]},
    "qualifying_interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["interaction_id", "description", "source", "status"],
        "properties": {
          "interaction_id": {"type": "string"},
          "description": {"type": "string"},
          "story_time": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "status": {"enum": ["PROPOSED", "CANON"]}
        },
        "additionalProperties": false
      }
    },
    "continuity_relevant_facts": {"type": "array", "items": {"type": "string"}},
    "knowledge_state": {"type": "array", "items": {"type": "string"}},
    "relationship_to_kairen": {"type": ["string", "null"]},
    "current_state": {"type": ["string", "null"]},
    "open_consequences": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
