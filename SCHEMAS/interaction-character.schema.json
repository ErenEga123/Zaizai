{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Interacting With Kairen",
  "type": "object",
  "required": ["character_id", "name", "tracking_status", "interactions"],
  "properties": {
    "character_id": {"type": "string"},
    "name": {"type": "string"},
    "tracking_status": {"enum": ["PROPOSED", "CANON", "REJECTED"]},
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "source", "status"],
        "properties": {
          "description": {"type": "string"},
          "story_time": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "status": {"enum": ["PROPOSED", "CANON"]}
        },
        "additionalProperties": false
      }
    },
    "relevant_facts": {"type": "array", "items": {"type": "string"}},
    "knowledge_boundaries": {"type": "array", "items": {"type": "string"}},
    "relationship_to_kairen": {"type": ["string", "null"]},
    "current_state": {"type": ["string", "null"]},
    "open_consequences": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
